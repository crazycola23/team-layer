{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Team Task Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "subject", "role", "baseRevision", "readSet", "writeSet", "inputs", "acceptance", "validation"],
  "properties": {
    "schemaVersion": {"const": 1},
    "taskId": {"type": "string", "minLength": 1},
    "sessionId": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "pattern": "^agent:.+"},
    "role": {"enum": ["product-architect", "fullstack", "reviewer"]},
    "baseRevision": {"type": "string", "pattern": "^git:[0-9a-fA-F]{7,64}$"},
    "readSet": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "writeSet": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revision", "authority"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "revision": {"type": "string", "minLength": 1},
          "authority": {"type": "string", "minLength": 1}
        }
      }
    },
    "acceptance": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "validation": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
