{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crazycola23/team-layer/schemas/session.schema.json",
  "title": "Team Session",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sessionId", "status", "integrationTarget", "createdAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "sessionId": {"type": "string", "minLength": 1},
    "status": {"enum": ["forming", "product-definition", "implementation", "review", "integration", "completed", "blocked", "cancelled"]},
    "integrationTarget": {"type": "string", "minLength": 1},
    "createdAt": {"$ref": "timestamp.schema.json"},
    "canonicalProvider": {"type": "string"},
    "notes": {"type": "string"}
  }
}
