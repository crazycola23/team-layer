{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/persistent-agent-team/identity.schema.json",
  "title": "Persistent Agent Identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "agentId", "role", "roleVersion", "skill", "skillVersion", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "agentId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "role": {"enum": ["product-architect", "fullstack", "reviewer"]},
    "roleVersion": {"type": "string", "minLength": 1},
    "skill": {"const": "persistent-agent-team"},
    "skillVersion": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"}
  }
}
